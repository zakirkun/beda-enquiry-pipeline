# Copy to .env and fill in. Never commit .env.

# Shared secret for the inbound webhooks. Generate one, don't reuse a key:
#   openssl rand -hex 32
WEBHOOK_SECRET=

# --- Model tiers ---------------------------------------------------------------
# Tier 1: fast/cheap first-pass classification and extraction.
# Tier 2: low-confidence escalation, and all customer-facing drafting.
# Either tier can use either provider (openai | anthropic), and both may use the
# same one. Only the keys the tiers actually name have to be set.
TIER1_PROVIDER=openai
TIER1_MODEL=gpt-4o-mini
TIER2_PROVIDER=anthropic
TIER2_MODEL=claude-sonnet-4-5

# Provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# All-OpenAI example: TIER2_PROVIDER=openai TIER2_MODEL=gpt-4o (no Anthropic key)
# All-Anthropic example: TIER1_PROVIDER=anthropic TIER1_MODEL=claude-haiku-4-5

# Optional tuning. Defaults are in internal/config/config.go.
# CONFIDENCE_THRESHOLD=0.72
# AUTO_ATTACH_MATCH_THRESHOLD=0.95
# WORKER_COUNT=4
# MAX_ATTEMPTS=3
# DEDUPE_WINDOW=24h
